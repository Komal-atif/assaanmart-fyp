# Optional. Copy this file to ".env" if your product images live on another website
# (for example your friend's frontend). Example:  VITE_IMAGE_BASE_URL=https://assanmart.com   (no slash at the end)
# You can also paste this link later in the app: Settings -> Product images (no restart needed).
# Leave empty to use the local folder public/images/products
VITE_IMAGE_BASE_URL=
VITE_BACKEND_URL=https://assaanmart-fyp.onrender.com
